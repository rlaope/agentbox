{
  "name": "agentbox",
  "version": "0.5.0",
  "type": "module",
  "description": "The AI Agent Framework — sandboxed multi-agent orchestration, high-throughput stateful agents, modular agent session manager & runtime for pi / codex / claude",
  "license": "MIT",
  "author": "rlaope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlaope/agentbox.git"
  },
  "bugs": {
    "url": "https://github.com/rlaope/agentbox/issues"
  },
  "homepage": "https://github.com/rlaope/agentbox#readme",
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "coding-agent",
    "sandbox",
    "session",
    "harness",
    "codex",
    "claude",
    "pi",
    "saas"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentbox": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/DESIGN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
